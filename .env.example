# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is git-ignored — real values live
# there and in Vercel's dashboard, never in this file.
#
# Only the first block is required. Everything below it is a service the app
# checks at runtime and degrades without: no Cloudinary means placeholder
# images, no Resend means emails print to the console, no Razorpay means
# checkout offers cash on delivery only. Nothing crashes.
# ---------------------------------------------------------------------------

# === REQUIRED ==============================================================

# Neon -> Dashboard -> Connection string. You need BOTH.
# DATABASE_URL has "-pooler" in the host and is what the app uses at runtime.
# DIRECT_URL is the same host WITHOUT it, and is what migrations use — Neon's
# pooler cannot run DDL. The wrong way round hangs the migration.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Signs session cookies. Generate: openssl rand -base64 32
# Use a different one in production than in development.
AUTH_SECRET=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Charubala Silver"


# === ADMIN ACCESS ==========================================================

# The owner's first account, created by `npm run db:seed`.
SEED_ADMIN_EMAIL="charubalasilver@gmail.com"
SEED_ADMIN_PASSWORD=""

# Secret door. With this set, /admin answers 404 until the visitor has been to
# /<this-value> once — so the panel cannot be found by typing /admin.
# Obscurity on top of the password, not instead of it.  openssl rand -hex 8
ADMIN_PATH_SECRET=""

# Optional second lock: comma-separated IPs that may reach the panel at all.
# Empty means any IP; the password and staff session still apply.
ADMIN_IP_ALLOWLIST=""


# === IMAGES — Cloudinary ===================================================
# Without these, products show placeholder photographs and the admin upload
# button explains what is missing.

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# The cloud name again — the browser needs its own copy to build image URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""


# === PAYMENTS — Razorpay ===================================================
# Start with TEST keys (rzp_test_...). Without them, checkout offers cash on
# delivery only and points at WhatsApp for UPI.

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# The key id again — the browser opens checkout with it.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Razorpay -> Settings -> Webhooks.  URL: <site>/api/webhooks/razorpay
# Events: payment.captured, payment.failed, order.paid
# This is what confirms an order when a customer loses signal on the bank page.
RAZORPAY_WEBHOOK_SECRET=""


# === EMAIL — Resend ========================================================
# Without a key, emails are logged to the console instead of sent.

RESEND_API_KEY=""
# Must be on a domain verified in Resend -> Domains.
EMAIL_FROM="orders@charubala.com"
EMAIL_ADMIN_NOTIFY="charubalasilver@gmail.com"


# === RATE LIMITING — Upstash Redis =========================================
# Without these the limiter falls back to per-instance memory: fine locally,
# not a real limit in production.

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# === OPTIONAL ==============================================================

# WhatsApp number, international form, digits only. Shows the order button.
NEXT_PUBLIC_WHATSAPP_NUMBER="918011210884"

# Google sign-in. Redirect URI: <site>/api/auth/callback/google
# Blank means the Google button simply does not appear.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Analytics, production only. Vercel Analytics needs no key — switch it on in
# the Vercel dashboard.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
