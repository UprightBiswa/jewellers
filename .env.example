# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local overrides .env and is git-ignored.
#
# REQUIRED to boot:   DATABASE_URL, DIRECT_URL, AUTH_SECRET
# Everything else is optional — each feature checks its own keys and degrades
# instead of crashing, so the shop runs before Razorpay or Google exist.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Silver Store"

# --- Database: Neon Postgres (REQUIRED) ------------------------------------
# DATABASE_URL is the POOLED connection ("-pooler" in the host) used at runtime.
# DIRECT_URL is the direct connection used by `prisma migrate` — Neon's pooler
# cannot run migrations. Both come from the Neon dashboard.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth (REQUIRED) -------------------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET=""

# First owner account, created by `npm run db:seed`. Change the password after
# the first sign-in.
SEED_ADMIN_EMAIL="owner@charubala.com"
SEED_ADMIN_PASSWORD=""

# --- Google sign-in (optional) ---------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI: {SITE_URL}/api/auth/callback/google
# Leave blank and the Google button simply does not appear.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Images: Cloudinary (optional) -----------------------------------------
# Without these, product images fall back to grey placeholders and the admin
# upload button explains what is missing. Nothing crashes.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="silver-store"
# Same cloud name again — the browser needs it to build image URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Payments: Razorpay (optional until launch) ----------------------------
# Start with the TEST keys (rzp_test_…); switch to live only after a real order.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Email: Resend (optional) ----------------------------------------------
# Without a key, emails are logged to the console instead of being sent.
# EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="orders@yourdomain.com"
EMAIL_ADMIN_NOTIFY="owner@example.com"

# --- Rate limiting: Upstash Redis (optional) -------------------------------
# Without these the limiter falls back to per-instance memory: fine locally,
# not a real limit in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- API access ------------------------------------------------------------
# Extra browser origins allowed to call /api/v1, comma separated. The storefront
# is same-origin and needs nothing here.
API_CORS_ORIGINS=""

# --- Admin panel lock (optional) -------------------------------------------
# Comma-separated IPs that may reach /admin at all. Anything else gets a 404.
# Empty = any IP, password still required.
ADMIN_IP_ALLOWLIST=""

# --- Analytics (optional) --------------------------------------------------
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# --- Shipping (phase 2) ----------------------------------------------------
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
